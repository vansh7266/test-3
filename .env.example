# Obyn Part 2 API Configuration
# Host URL of Part 2 (e.g. https://api.obyn.ai or your custom Part 2 host)
OBYN_HOST=https://your-part2-host.com

# Obyn Bearer API Token
OBYN_API_TOKEN=your_obyn_api_token_here

# Obyn Workspace and Project Identifiers
WORKSPACE_ID=your_workspace_id_here
PROJECT_ID=your_project_id_here

# Unique Service Identifier for this test service
SERVICE_ID=Test-3

# Heartbeat interval in seconds (default: 60)
HEARTBEAT_INTERVAL_SECONDS=60

# Optional: Force initial status override (up | degraded | down)
# FORCE_STATUS=up

# Web Server Port (default: 3000)
PORT=3000
